# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1

# Overlay of the macports-ports 'vulkan-validationlayers' port
# (graphics/vulkan-validationlayers).
#
# Difference from upstream: post-destroot rewrites the generated layer manifest so
# that library_path is absolute. The manifest Khronos generates names the layer
# library without a directory ("libVkLayer_khronos_validation.dylib"), and the loader
# passes that string straight to dlopen(). macOS does not apply dyld fallback search
# paths to a bare dlopen() name, so the layer cannot be loaded:
#
#   dlopen(libVkLayer_khronos_validation.dylib, 0x0005): no such file
#
# A symlink in /usr/local/lib does not help - the loader never searches it for a name
# with no path separator. The layer manifest spec allows a relative-to-manifest path,
# but macOS only loads the absolute form reliably, so pin it at install time and
# verify the rewrite happened.
#
# The revision bump additionally keeps the official binary archive from satisfying
# this requirement (see the note in ports/graphics/vulkan-tools/Portfile).

github.setup        KhronosGroup Vulkan-ValidationLayers 1.4.363.0 vulkan-sdk-
github.tarball_from archive
name                vulkan-validationlayers
revision            1
categories          graphics
license             Apache-2
maintainers         nomaintainer
description         Vulkan validation layers with a loadable macOS manifest
long_description    Provides the Khronos validation layer, with the installed \
                    manifest rewritten to name the layer library by absolute path.
homepage            https://vulkan.lunarg.com

checksums           rmd160  0753348c8a46cf546f21ed63e71c4f5aff6daf0a \
                    sha256  36720627913a591ae8ffc0f24b3c04f98af65242c9b7215d1944a85ff5b70e00 \
                    size    8516350

cmake.build_type    Release

depends_build-append \
                    port:spirv-headers \
                    port:vulkan-headers \
                    port:vulkan-volk
depends_lib-append  \
                    port:glslang \
                    port:spirv-tools \
                    port:vulkan-loader \
                    port:vulkan-utility-libraries

set py_ver 3.14
set py_ver_nodot [string map {. {}} ${py_ver}]
foreach stage {configure build destroot test} {
    ${stage}.env-append PATH=${frameworks_dir}/Python.framework/Versions/${py_ver}/bin:$env(PATH)
}
depends_build-append port:python${py_ver_nodot}

configure.args-append -DVULKAN_HEADERS_INSTALL_DIR=${prefix} \
                      -DGLSLANG_INSTALL_DIR=${prefix} \
                      -DSPIRV_HEADERS_INSTALL_DIR=${prefix} \
                      -DUSE_ROBIN_HOOD_HASHING=OFF

post-destroot {
    set manifest ${destroot}${prefix}/share/vulkan/explicit_layer.d/VkLayer_khronos_validation.json
    if {![file isfile ${manifest}]} {
        return -code error "validation layer manifest was not installed at ${manifest}"
    }

    set library ${prefix}/lib/libVkLayer_khronos_validation.dylib
    # Braces: the pattern must reach reinplace exactly as written (Tcl would
    # otherwise substitute on the square brackets).
    set pattern {\"library_path\"[[:space:]]*:[[:space:]]*\"[^\"]*\"}
    set replacement [format {"library_path" : "%s"} ${library}]
    reinplace -locale C $pattern $replacement ${manifest}

    # Fail the build rather than shipping a manifest that cannot be loaded.
    set contents [join [split [exec cat ${manifest}] "\n"] "\n"]
    if {[string first ${library} ${contents}] < 0} {
        return -code error "could not rewrite library_path in ${manifest}"
    }
}
